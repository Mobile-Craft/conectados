# Variante de la app: development | preview | production (por defecto: production)
# En development se añade el sufijo ".dev" al bundle id/package y " (Dev)" al nombre.
APP_VARIANT=development

# Supabase del entorno (dev: conectados-dev). Valores públicos por diseño: la clave publishable
# va en el cliente y la protege RLS. Las claves secret y service_role NUNCA van aquí.
# En EAS viven como variables del entorno (development / preview / production).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Dominio de los universal links / App Links (https://<dominio>/pack/<slug>). Opcional: sin él la
# app solo abre conectados://. Va sin protocolo, por ejemplo: conectados.app
# APP_LINK_DOMAIN=
